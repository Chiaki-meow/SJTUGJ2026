  m_Name: DeanBossEncounter
  m_EditorClassIdentifier: 
  bloodyKnifeCheckTargets: 0800000009000000
  bloodyKnifeIntroText: "\u9662\u957F\u7684\u5F71\u5B50\u6321\u4F4F\u4E86\u95E8\u3002\u4F60\u63E1\u7D27\u67D3\u8840\u7684\u624B\u672F\u5200\uFF0C\u53EA\u80FD\u6B63\u9762\u538B\u5236\u4ED6\u3002"
  bloodyKnifeSingleSuccessText: "\u4F60\u7684\u653B\u51FB\u903C\u9000\u4E86\u9662\u957F\uFF0C\u4F46\u4ED6\u4ECD\u5728\u9ED1\u6697\u4E2D\u91CD\u65B0\u7AD9\u8D77\u3002"
  bloodyKnifeWinText: "\u4F60\u51FB\u9000\u4E86\u9662\u957F\uFF0C\u533B\u9662\u7684\u5E7B\u8C61\u5F00\u59CB\u5D29\u584C\u3002"
  bloodyKnifeFailureText: "\u9662\u957F\u6293\u4F4F\u7834\u7EFD\u53CD\u51FB\uFF0C\u4F60\u7684\u751F\u547D\u4E0B\u964D\u3002"
  bloodyKnifeLoseText: "\u4F60\u6CA1\u80FD\u6491\u8FC7\u9662\u957F\u7684\u8FFD\u51FB\uFF0C\u5012\u5728\u4E86\u9662\u957F\u5BA4\u91CC\u3002"
  patientLetterCheckTargets: 0a00000005000000
  patientLetterIntroText: "\u9662\u957F\u5426\u8BA4\u4E00\u5207\u3002\u4F60\u62FF\u51FA\u60A3\u8005\u7684\u9057\u4E66\uFF0C\u5C1D\u8BD5\u7528\u8BC1\u636E\u6495\u5F00\u8C0E\u8A00\u3002"
  patientLetterSingleSuccessText: "\u9662\u957F\u7684\u8BED\u6C14\u5F00\u59CB\u52A8\u6447\uFF0C\u4F46\u4ED6\u4ECD\u8BD5\u56FE\u63A9\u76D6\u6700\u540E\u7684\u771F\u76F8\u3002"
  patientLetterWinText: "\u8BC1\u8BCD\u4E0E\u9057\u4E66\u62FC\u6210\u5B8C\u6574\u771F\u76F8\uFF0C\u9662\u957F\u7684\u4F2A\u88C5\u5F7B\u5E95\u5D29\u6E83\u3002"
  patientLetterFailureText: "\u9662\u957F\u7528\u8C0E\u8A00\u538B\u8FEB\u4F60\u7684\u601D\u7EEA\uFF0C\u4F60\u7684\u751F\u547D\u4E0B\u964D\u3002"
  patientLetterLoseText: "\u4F60\u6CA1\u80FD\u8BC1\u660E\u771F\u76F8\uFF0C\u610F\u8BC6\u88AB\u9662\u957F\u7684\u8C0E\u8A00\u541E\u6CA1\u3002"
  failureDamage: 1
  requiredSuccessCount: 2
